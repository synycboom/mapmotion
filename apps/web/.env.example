# Product analytics. Leave both unset and the app makes no analytics requests
# at all — that is the default for local development and CI.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, so setting these requires a
# redeploy, not just an environment change.
NEXT_PUBLIC_POSTHOG_KEY=
# EU cloud by default. Use https://us.i.posthog.com for a US project, or your
# own reverse proxy.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: stamped onto every event so a regression can be tied to a deploy.
# On Vercel, set this to $VERCEL_GIT_COMMIT_SHA.
NEXT_PUBLIC_COMMIT_SHA=

# Optional: an OSRM-compatible routing instance. Defaults to the FOSSGIS
# community servers.
ROUTER_URL=
